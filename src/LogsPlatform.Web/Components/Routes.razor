<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <ErrorBoundary>
            <ChildContent>
                <RouteView RouteData="routeData" />
            </ChildContent>
            <ErrorContent>
                <p>Something went wrong loading this page. The link may be invalid, or point to something that no longer exists.</p>
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <p>Page not found.</p>
    </NotFound>
</Router>
